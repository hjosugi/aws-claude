# Build settings for one environment. Copy this file to .env, then build.
#
# - A value here replaces the same value in policy.yaml.
# - Empty or missing keys keep the value from policy.yaml.
# - The values go into the exe. Do not put passwords here.
# - .env is not committed. For more environments, keep files like .env.prod and
#   build with: build.ps1 -EnvFile .env.prod   (or: ./build.sh --env-file .env.prod)
# - The same keys also work as normal env vars at build time. They win over this file.
#
# Fixed, not a setting: the backend is Amazon Bedrock, and every model uses a
# "jp." inference profile (Tokyo and Osaka only).

# Bedrock source region: ap-northeast-1 (Tokyo) or ap-northeast-3 (Osaka).
AWS_CLAUDE_REGION=ap-northeast-1

# Models. Each must be a jp. profile, or an application inference profile ARN in Japan.
# "none" removes a model. Example for Haiku only: AWS_CLAUDE_MODEL_SONNET=none
AWS_CLAUDE_MODEL_HAIKU=jp.anthropic.claude-haiku-5-5
AWS_CLAUDE_MODEL_SONNET=jp.anthropic.claude-sonnet-4-6
AWS_CLAUDE_MODEL_OPUS=
# Model at start: haiku, sonnet, or opus.
AWS_CLAUDE_DEFAULT_MODEL=haiku

# Haiku 5.5 costs 5x for prompts over 100K tokens, so keep 100000.
AWS_CLAUDE_AUTO_COMPACT_WINDOW=100000
# low, medium, high, or xhigh.
AWS_CLAUDE_EFFORT_LEVEL=low
# true or false.
AWS_CLAUDE_ALLOW_WEB_FETCH=false
AWS_CLAUDE_BLOCK_GREP=false
AWS_CLAUDE_TOOL_RTK=true
AWS_CLAUDE_TOOL_GRAPHIFY=true

# AWS login with an IAM role. aws-claude never uses a claude.ai login or an API key.
# With AWS_CLAUDE_ROLE_ARN, aws-claude adds this profile to ~/.aws/config on the user's PC
# and makes claude use it:
#   [profile aws-claude]
#   role_arn = <AWS_CLAUDE_ROLE_ARN>
#   source_profile = <AWS_CLAUDE_SOURCE_PROFILE, or default>
#   region = <AWS_CLAUDE_REGION>
# Example: AWS_CLAUDE_ROLE_ARN=arn:aws:iam::123456789012:role/claude-code
AWS_CLAUDE_ROLE_ARN=
# Name of the profile. Default: aws-claude. Without a role ARN, this profile must already exist.
AWS_CLAUDE_PROFILE=
# Profile with the login for the role. Default: default.
AWS_CLAUDE_SOURCE_PROFILE=
# Command that claude runs when the credentials are expired.
# Example: AWS_CLAUDE_AUTH_REFRESH=aws sso login --profile my-sso
AWS_CLAUDE_AUTH_REFRESH=

# Local proxy that only lets the allowed hosts through. true or false.
# Allowed: the AWS endpoints in Japan, and the development hosts in policy.yaml
# (GitHub, PyPI, npm, Maven Central, Gradle). Check the result with: aws-claude show-policy
AWS_CLAUDE_PROXY=true
# Corporate proxy, as http://host:port. Empty: use HTTPS_PROXY or the OS settings.
AWS_CLAUDE_PROXY_UPSTREAM=
# Hosts of this environment, added to the list in policy.yaml. Separate with commas.
# Example: AWS_CLAUDE_PROXY_ADD_HOSTS=nexus.example.co.jp,*.git.example.co.jp
AWS_CLAUDE_PROXY_ADD_HOSTS=
